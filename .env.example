# RIPPLE configuration. Copy to .env (never commit .env).
PORT=8787
RIPPLE_DB_PATH=data/ripple.db
# Seed password for demo users in development. REQUIRED to be set when NODE_ENV=production.
RIPPLE_SEED_PASSWORD=ripple-demo
# Optional: enables model-generated *wording* for the client communication draft. Without it everything is deterministic.
ANTHROPIC_API_KEY=
RIPPLE_MODEL=claude-sonnet-5-5
# Switch (https://github.com/sandbox-quantum/switch). Leave empty for transparent LOCAL collaboration mode.
SWITCH_BRIDGE_URL=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
# Comma-separated Switch agent names to invite, mapped role=agentName, e.g. kitchen=ripple-kitchen,procurement=ripple-procurement
SWITCH_ROLE_AGENTS=
# RIPPLE's own Switch agent name (it joins every room it creates). Written by scripts/switch-register.mjs.
SWITCH_SELF_NAME=
# 1 = create agent-only rooms (internal_only). Needed when Switch's chat bridge (Mattermost) is not running.
SWITCH_INTERNAL_ONLY=
# Session 15 (Level 3) — the settlement arbiter's OWN identity. assume_role acts as the CALLER, so the exclusive
# settlement-signer lease must be taken with the arbiter's own key (scripts/switch-register.mjs records it in
# data/switch-agents.local.json). Without these, the role is still defined exclusive at creation but not assumed.
SWITCH_ARBITER_AGENT_ID=
SWITCH_ARBITER_AGENT_API_KEY=
SWITCH_ARBITER_NAME=ripple-arbiter
# Optional human gateway session credentials for GET /rooms/{id}/yaml (self-encoding room capture on completion).
# The agent API key is NOT accepted on the gateway; without these RIPPLE writes its labelled local fallback playbook.
SWITCH_GATEWAY_URL=
SWITCH_GATEWAY_TOKEN=
# Session 16: Ed25519 PKCS#8 private key that signs ledger receipts (POST /api/dash/trust/receipt). Never commit a real key.
# Leave empty to issue UNSIGNED receipts (they prove only the chain head). To generate one: openssl genpkey -algorithm ED25519
# then paste the PEM on one line, replacing each newline with a literal \n.
RIPPLE_RECEIPT_PRIVATE_KEY=
