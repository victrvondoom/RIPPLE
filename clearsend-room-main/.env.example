# ClearSend Room. Copy to dashboard/.env.local (dashboard) and to .env in the agent's
# working directory (CLI). Never commit real values.

# --- Shared: dashboard <-> agent CLI ---
# Random string; the CLI sends it as x-clearsend-api-key. Generate: openssl rand -hex 32
CLEARSEND_API_KEY=
# Where the dashboard runs (CLI target + links posted in the room)
CLEARSEND_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Free model only (agent in OpenCode + server-side deliverable verifier) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
# Optional third fallback: build.nvidia.com free endpoint
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# --- PayPal SANDBOX (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Upstash Redis REST (console.upstash.com, free tier) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- HMAC secret for payer/recipient/verifier links (16+ chars). openssl rand -hex 32 ---
ESCROW_LINK_SECRET=

# --- Flights ---
# Optional: Sky-Scrapper on RapidAPI for live priced fares. Without it, results are schedule-only.
RAPIDAPI_KEY=
# Optional: OpenSky API client (opensky-network.org account > API client). Anonymous works with lower limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
