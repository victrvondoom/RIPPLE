{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "noEmit": true, "skipLibCheck": true,
    "jsx": "react-jsx", "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node"], "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts"]
}
